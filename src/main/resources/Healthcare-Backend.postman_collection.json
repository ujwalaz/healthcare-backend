        },
        {
          "name": "Verify security question answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.resetToken) {",
                  "    pm.collectionVariables.set('resetToken', body.data.resetToken);",
                  "    console.log('Reset token saved to the collection variables.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"PATIENT\",\n  \"identifier\": \"8551002220\",\n  \"questionId\": 1,\n  \"answer\": \"St. Mary's School\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/password-reset/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "password-reset",
                "verify"
              ]
            },
            "description": "Use role PATIENT, DOCTOR, or ADMIN. Identifier is the registered mobile number for patients/admins and phone number for doctors. The answer is normalized case-insensitively by the backend."
          },
          "response": []
        },
        {
          "name": "Complete password reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"NewSecret@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/password-reset/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "password-reset",
                "complete"
              ]
            },
            "description": "Run after Verify security question answer. The reset token is one-time and expires after 10 minutes."
