        {
          "name": "Log in as a patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the response body\r",
                  "let response = pm.response.json();\r",
                  "\r",
                  "// Check if access_token exists in the response\r",
                  "if (response.data.token) {\r",
                  "    // Set access_token as an environment variable\r",
                  "    pm.environment.set(\"jwt\", response.data.token);\r",
                  "    console.log(\"Access token set in environment variables.\");\r",
                  "} else {\r",
                  "    console.warn(\"access_token not found in response.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"8551002227\",\n  \"password\": \"Test@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
